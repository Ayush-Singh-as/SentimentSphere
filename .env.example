# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Nothing here is needed for the text pipeline or for any TESS-based work: the
# text aggregate is tracked in the repo and TESS is already on disk. Credentials
# are only required for the datasets and services noted below.

# --------------------------------------------------------------------------- #
# Hugging Face — model/dataset hosting and the public Space
# Needed for: publishing weights, `make demo` deploys, Space builds
#
# How to get it:
#   1. https://huggingface.co/settings/tokens
#   2. "Create new token" -> type: Write
#   3. Scope it to your namespace; name it e.g. "sentimentsphere-ci"
# --------------------------------------------------------------------------- #
HF_TOKEN=
HF_USERNAME=

# --------------------------------------------------------------------------- #
# Kaggle — FER-2013 (the facial expression corpus)
# Needed for: Phase 1 vision baseline, Phase 4 training
#
# How to get it:
#   1. https://www.kaggle.com/settings/account -> API -> "Create New Token"
#   2. That downloads kaggle.json containing {"username":..., "key":...}
#   3. Either paste the two values below, or drop kaggle.json at ~/.kaggle/kaggle.json
#   4. Accept the competition rules once, or the download 403s:
#      https://www.kaggle.com/datasets/msambare/fer2013
# --------------------------------------------------------------------------- #
KAGGLE_USERNAME=
KAGGLE_KEY=

# --------------------------------------------------------------------------- #
# Weights & Biases — experiment tracking (optional)
# Needed for: Phase 2+ training runs with public dashboards
#
# How to get it:
#   1. https://wandb.ai/authorize
#   2. Set WANDB_MODE=offline to log locally without an account
# --------------------------------------------------------------------------- #
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=sentimentsphere
WANDB_MODE=online

# --------------------------------------------------------------------------- #
# Local paths (defaults are fine)
# --------------------------------------------------------------------------- #
SPHERE_DATA_DIR=data
SPHERE_ARTIFACTS_DIR=artifacts
SPHERE_REPORTS_DIR=reports
