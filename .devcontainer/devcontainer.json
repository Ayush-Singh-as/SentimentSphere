{
  "name": "SentimentSphere",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "UPGRADE_PLAN.md"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
          }
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.mypy-type-checker",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "onCreateCommand": "uv sync --extra dev && uv run pre-commit install",
  "postAttachCommand": "uv run sphere labels && echo '\\nReady. See UPGRADE_PLAN.md for the roadmap, or run: make help'",
  "portsAttributes": {
    "7860": { "label": "Gradio demo", "onAutoForward": "openPreview" },
    "8000": { "label": "FastAPI", "onAutoForward": "silent" },
    "8001": { "label": "Docs", "onAutoForward": "silent" }
  },
  "forwardPorts": [7860, 8000, 8001]
}
